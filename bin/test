#!/usr/bin/env ruby
# frozen_string_literal: true

# One-command test runner — the short name for the runner documented in
# test/test_helper.rb. Puts test/ on the load path (so `require "test_helper"`
# resolves) and loads the requested test files; `minitest/autorun` (pulled in by
# the helper) installs an at_exit hook that runs the suite and sets the process
# exit status, so CI and `&&` chains see failures.
#
#   bin/test                              # whole suite
#   bin/test test/config_test.rb          # one (or several) files
#   bin/test --seed 123 -n /sanitize/     # minitest flags pass straight through
#
# Args naming a test file are loaded; everything else (minitest flags like
# --seed/-n/--verbose and their values) is left in ARGV for minitest to parse.
test_dir = File.expand_path("../test", __dir__)
$LOAD_PATH.unshift(test_dir)

file_args = ARGV.select { |a| a.end_with?("_test.rb") }
ARGV.replace(ARGV - file_args) # leave only minitest flags (--seed, -n, …) for autorun

# A bare name (`config_test.rb`) resolves under test/ too, not just cwd.
files = if file_args.empty?
          Dir[File.join(test_dir, "*_test.rb")].sort
        else
          file_args.map { |f| File.exist?(f) ? f : File.join(test_dir, File.basename(f)) }
        end

files.each { |f| require File.expand_path(f) }
