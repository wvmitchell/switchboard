#!/usr/bin/env ruby
# frozen_string_literal: true

# A tmux popup runs in a non-interactive shell that doesn't load rbenv (set up
# in .zshrc), so `env ruby` can resolve to macOS system Ruby 2.6 — too old: the
# floor is 3.3, the oldest Ruby still getting security fixes upstream.
# If so, re-exec once under a modern ruby. The SB_REEXEC guard prevents an exec loop,
# and a re-exec that still lands below the floor aborts here instead of failing to load.
if RUBY_VERSION < "3.3"
  modern = !ENV["SB_REEXEC"] && [
    File.expand_path("~/.rbenv/shims/ruby"),
    "/opt/homebrew/opt/ruby/bin/ruby",
    "/opt/homebrew/bin/ruby",
    "/usr/local/bin/ruby"
  ].find do |path|
    # An rbenv shim can itself resolve below the floor; ask each one instead of taking the first.
    File.executable?(path) &&
      system(path, "-e", 'exit RUBY_VERSION >= "3.3"', out: File::NULL, err: File::NULL)
  end

  if modern
    ENV["SB_REEXEC"] = "1"
    exec(modern, __FILE__, *ARGV)
  end
  abort "switchboard needs Ruby >= 3.3 (running #{RUBY_VERSION}); install a newer Ruby or put one first on PATH"
end

# A C/POSIX locale (a tmux pane started without LANG) would make Ruby tag every file read
# and command output US-ASCII, so comparing, parsing or regex-matching a UTF-8 path or file
# fails or raises. switchboard's files and paths are UTF-8 whatever the locale.
Encoding.default_external = Encoding::UTF_8

# Resolve lib/ relative to this script (works even when symlinked onto PATH).
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "switchboard"

# Canonical path to this script, so tmux can spawn the sidebar pane by
# re-invoking us (`switchboard sidebar`). Resolved from __FILE__ (not $0) so it
# works when symlinked onto PATH or run as a bare command, where $0 carries no
# directory. StablePath swaps a Homebrew keg path for its upgrade-proof opt/ twin.
ENV["SWITCHBOARD_BIN"] = Switchboard::StablePath.resolve(File.realpath(__FILE__))

Switchboard::CLI.run(ARGV)
